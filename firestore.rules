rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPortalAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /events/{eventId} {
      allow get, list: if isPortalAdmin() || resource.data.visibility == 'public';
      allow create, update, delete: if isPortalAdmin();

      match /reports/{reportId} {
        function eventIsPublic() {
          return get(/databases/$(database)/documents/events/$(eventId)).data.visibility == 'public';
        }
        allow get, list: if isPortalAdmin() || (eventIsPublic() && resource.data.published == true);
        allow create, update, delete: if isPortalAdmin();
      }

      match /state/{stateId} {
        function eventIsPublic() {
          return get(/databases/$(database)/documents/events/$(eventId)).data.visibility == 'public';
        }
        allow get, list: if isPortalAdmin() || eventIsPublic();
        allow create, update, delete: if isPortalAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
